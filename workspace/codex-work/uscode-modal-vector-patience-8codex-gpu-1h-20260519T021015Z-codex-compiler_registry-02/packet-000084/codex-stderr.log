+        section="5601",
+        text="This authority applies as provided in subsection (b).",
+    )
+
+    ranking = ranked_modal_families(codec.encode_sample(sample))
+
+    assert ranking[0]["family"] == "frame"
+    conditional_share = next(
+        float(item["share"])
+        for item in ranking
+        if item["family"] == "conditional_normative"
+    )
+    frame_share = next(
