+                "share": 0.32,
+                "source": "logit_softmax_fallback",
+            },
+            {
+                "family": ModalLogicFamily.TEMPORAL.value,
+                "count": 0,
+                "logit": 1.4,
+                "share_raw": 0.24,
+                "share": 0.24,
+                "source": "logit_softmax_fallback",
