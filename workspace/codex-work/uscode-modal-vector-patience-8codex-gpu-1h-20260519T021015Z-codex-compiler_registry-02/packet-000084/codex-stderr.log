from ipfs_datasets_py.optimizers.logic_theorem_optimizer.spacy_modal_codec import SpaCyLegalEncoder, ranked_modal_families, modal_ambiguity_signals
from ipfs_datasets_py.optimizers.logic_theorem_optimizer.modal_registry import DEFAULT_MODAL_REGISTRY

samples = [
    \"As provided in section 3, this authority applies.\",
    \"For the period beginning on January 1, 2030, this authority applies.\",
    \"The agency shall administer this program under section 3 of this title.\",
    \"Within 30 days after June 1, 2030, and before the end of the fiscal year, the Secretary may issue guidance.\",
    \"In the event that this authority applies, the Secretary shall act.\",
    \"In the event that the authority under section 5 applies, the Administrator acts.\",
]
enc = SpaCyLegalEncoder(registry=DEFAULT_MODAL_REGISTRY)
for text in samples:
    e = enc.encode(text)
    print('---')
    print(text)
    print('counts', e.modal_family_counts())
    print('ranking', ranked_modal_families(e))
    print('signals', {k:v for k,v in modal_ambiguity_signals(e).items() if v})
    print('cues', [(c.family,c.cue,c.symbol) for c in e.cues])
