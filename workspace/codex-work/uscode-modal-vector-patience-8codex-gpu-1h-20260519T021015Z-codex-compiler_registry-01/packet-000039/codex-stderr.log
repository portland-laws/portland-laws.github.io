    "ModalParseProfile",
    "ModalRegistry",
    "ModalSemanticsSpec",
    "ModalSystem",
    "is_normative_modal_family",
    "signal_free_adaptive_ambiguity_targets",
    "supports_signal_free_adaptive_ambiguity_pair",
]

