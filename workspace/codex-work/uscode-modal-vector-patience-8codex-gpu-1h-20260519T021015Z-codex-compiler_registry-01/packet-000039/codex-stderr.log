'Authority jurisdiction administered by the Secretary shall apply.',
'Authority, jurisdiction, and administration of this section may be exercised.',
'The authority of the Secretary and jurisdiction of the Department is as provided by this section and shall apply.',
'The authority under this chapter, part of this title, administered by the Secretary, may be exercised.',
'The authority under this chapter, part of this title, administered by the Secretary, authorized by law.',
'Authority under this section and jurisdiction under this title are authorized.',
'The authority is part of the Department and is administered by the Secretary and must issue notice.',
]
for t in texts:
    e=enc.encode(t,document_id='x')
    r=ranked_modal_families(e)
    log=dec.family_logits(e,modal_families=['deontic','frame','temporal','conditional_normative','alethic'])
    top=max(log,key=log.get)
    print('\\n',t)
    print('cues',[(c.family,c.cue) for c in e.cues])
    print('rank',r[:3])
    print('top_logit',top,{k:round(v,3) for k,v in log.items()})
