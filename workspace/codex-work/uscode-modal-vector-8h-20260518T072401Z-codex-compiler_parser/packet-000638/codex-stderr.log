   430	def test_parser_extracts_deontic_and_temporal_cues() -> None:
   431	    parser = LegalModalParser()
   432	
   433	    cues = parser.extract_cues("The agency must respond within 30 days.")
   434	    families = {cue.family.value for cue in cues}
   435	    cue_terms = {cue.cue for cue in cues}
   436	
   437	    assert "deontic" in families
   438	    assert "temporal" in families
   439	    assert {"must", "within"}.issubset(cue_terms)
