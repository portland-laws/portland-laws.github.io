  1074	    def _contains_sec_heading_reference(
  1075	        self,
  1076	        text: str,
  1077	        *,
  1078	        citation_section: str,
  1079	    ) -> bool:
  1080	        if not citation_section:
  1081	            return False
  1082	        return self._contains_citation_section_reference(
  1083	            text,
  1084	            citation_section,
