   179	class LegalModalParser:
   180	    """Small deterministic parser that compiles legal text into modal IR."""
   181	
   182	    def __init__(self, registry: ModalRegistry = DEFAULT_MODAL_REGISTRY) -> None:
   183	        self.registry = registry
   184	
   185	    def normalize_text(self, text: str) -> str:
   186	        """Normalize whitespace while preserving legal punctuation."""
   187	        return _WHITESPACE_RE.sub(" ", text).strip()
   188	
   189	    def segment(self, text: str) -> List[LegalSegment]:
   190	        """Split normalized legal text into deterministic legal segments."""
   191	        normalized = self.normalize_text(text)
   192	        segments: List[LegalSegment] = []
   193	        for match in _SEGMENT_RE.finditer(normalized):
   194	            segment_text = match.group(0).strip()
   195	            if not segment_text:
   196	                continue
   197	            segments.append(
   198	                LegalSegment(
   199	                    text=segment_text,
   200	                    start_char=match.start(),
   201	                    end_char=match.end(),
   202	                    role=self._classify_segment_role(segment_text),
   203	                )
   204	            )
   205	        return segments
   206	
   207	    def extract_cues(self, text: str) -> List[ModalCueSpan]:
   208	        """Extract modal cue spans from text using registry cue terms."""
   209	        normalized = self.normalize_text(text)
   210	        found: List[ModalCueSpan] = []
   211	        for profile in self.registry.all_profiles():
   212	            for operator in profile.operators:
   213	                for cue in operator.cue_terms:
   214	                    pattern = re.compile(rf"(?<!\w){re.escape(cue)}(?!\w)", re.IGNORECASE)
   215	                    for match in pattern.finditer(normalized):
   216	                        if self._is_calendar_month_may_cue(
   217	                            normalized_text=normalized,
   218	                            cue=cue,
   219	                            start_char=match.start(),
   220	                            end_char=match.end(),
   221	                        ):
   222	                            continue
   223	                        found.append(
   224	                            ModalCueSpan(
   225	                                family=profile.family,
   226	                                profile=profile,
   227	                                operator=operator,
   228	                                cue=cue,
   229	                                start_char=match.start(),
   230	                                end_char=match.end(),
   231	                            )
   232	                        )
   233	        return sorted(found, key=lambda cue: (cue.start_char, cue.end_char, cue.family.value, cue.operator.symbol))
   234	
   235	    def _is_calendar_month_may_cue(
   236	        self,
   237	        *,
   238	        normalized_text: str,
   239	        cue: str,
   240	        start_char: int,
   241	        end_char: int,
   242	    ) -> bool:
   243	        """Treat `May 13, 2002` date literals as temporal context, not deontic permission."""
   244	        if cue.lower() != "may":
   245	            return False
   246	        if start_char > 0 and normalized_text[start_char - 1].isalnum():
   247	            return False
   248	        trailing = normalized_text[end_char:]
   249	        return bool(re.match(r"^\s+\d{1,2}(?:,\s*|\s+)\d{4}\b", trailing))
   250	
   251	    def parse(
   252	        self,
