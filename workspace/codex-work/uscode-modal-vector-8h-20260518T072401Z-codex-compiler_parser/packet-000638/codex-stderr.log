   408	def _coarse_uscode_heading_noise_text(section: str, heading: str) -> str:
   409	    noise_tokens = " ".join(chr(ord("a") + (index % 26)) for index in range(160))
   410	    return (
   411	        "U S C title archive register digest taxonomy index chapter crosswalk "
   412	        f"sec {section} {heading} "
   413	        f"{noise_tokens}"
   414	    )
