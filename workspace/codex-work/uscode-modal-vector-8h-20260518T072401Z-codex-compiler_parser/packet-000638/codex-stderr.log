  1087	    def _segment_or_neighbor_has_citation_section_reference(
  1088	        self,
  1089	        *,
  1090	        index: int,
  1091	        segments: Sequence[LegalSegment],
  1092	        citation_section: str,
  1093	    ) -> bool:
  1094	        for offset in (-2, -1, 0, 1, 2):
  1095	            position = index + offset
  1096	            if position < 0 or position >= len(segments):
  1097	                continue
  1098	            segment_text = segments[position].text
  1099	            if self._contains_citation_section_reference(segment_text, citation_section):
  1100	                return True
  1101	            if self._starts_with_citation_section_reference(segment_text, citation_section):
  1102	                return True
  1103	        return False
