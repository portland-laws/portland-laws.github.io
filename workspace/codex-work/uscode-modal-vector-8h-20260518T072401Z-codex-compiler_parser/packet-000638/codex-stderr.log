   481	def test_modal_codec_encodes_all_modal_families_with_frame_logic() -> None:
   482	    codec = DeterministicModalLogicCodec(
   483	        ModalLogicCodecConfig(parser_backend="spacy", embedding_dimensions=8)
   484	    )
   485	
   486	    result = codec.encode(
   487	        "The agency must provide notice within 30 days after application.",
   488	        document_id="sample-doc",
   489	        citation="5 U.S.C. 552",
   490	        source="us_code",
   491	    )
   492	
   493	    families = {formula.operator.family for formula in result.modal_ir.formulas}
   494	    assert {"deontic", "temporal"}.issubset(families)
   495	    assert result.modal_ir.metadata["llm_call_count"] == 0
   496	    assert result.selected_frame == "administrative_notice_hearing"
   497	    assert result.modal_ir.frame_candidates
   498	    assert len(result.decoded_embedding) == 8
   499	    assert result.losses["cross_entropy_loss"] >= 0.0
   500	    assert "flogic_similarity_loss" in result.losses
   501	    assert result.losses["text_reconstruction_loss"] == 0.0
   502	    assert result.losses["modal_span_coverage_loss"] == 0.0
   503	    assert -1.0 <= result.losses["cosine_similarity"] <= 1.0
   504	    assert result.flogic_result is not None
   505	    assert result.flogic_result.ontology_consistent is True
   506	    assert result.kg_triples
   507	    assert all(triple["predicate"] for triple in result.kg_triples)
   508	    assert result.modal_ir.frame_logic.triples
   509	    assert result.modal_ir.frame_logic.to_triples() == result.kg_triples
   510	    assert result.modal_ir.frame_logic.selected_frame == result.selected_frame
   511	    assert result.modal_ir.frame_logic.graph_id == "sample-doc:flogic"
   512	    assert "LegalModalDocument" in result.modal_ir.frame_logic.neo4j_node_labels
   513	    assert result.modal_ir.metadata["flogic_triple_count"] == len(result.kg_triples)
   514	    assert result.modal_ir.metadata["flogic_triples"] == result.kg_triples
   515	    assert result.flogic_ontology.frames
   516	    assert result.neo4j_graph_data.metadata["neo4j_compatible"] is True
   517	    assert result.neo4j_graph_data.node_count > 0
   518	    assert result.neo4j_graph_data.relationship_count == len(result.kg_triples)
   519	    assert "LegalModalDocument" in result.neo4j_graph_data.schema.node_labels
   520	    engine, import_report = import_graph_data_to_graph_engine(result.neo4j_graph_data)

