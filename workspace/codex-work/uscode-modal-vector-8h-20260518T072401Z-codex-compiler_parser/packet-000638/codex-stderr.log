   417	def test_parser_normalizes_and_segments_legal_text() -> None:
   418	    parser = LegalModalParser()
   419	    text = "  The agency   must provide notice. Unless waived, the applicant may appeal. "
   420	
   421	    segments = parser.segment(text)
   422	
   423	    assert [segment.text for segment in segments] == [
   424	        "The agency must provide notice.",
   425	        "Unless waived, the applicant may appeal.",
   426	    ]
   427	    assert segments[1].role == "condition"
   428	
