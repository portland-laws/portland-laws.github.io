  1025	    def _looks_like_transferred_section_heading(
  1026	        self,
  1027	        segment_text: str,
  1028	        *,
  1029	        citation_section: str,
  1030	    ) -> bool:
  1031	        normalized = self.normalize_text(segment_text).lower()
  1032	        if "transferred" not in normalized:
  1033	            return False
  1034	        if normalized.startswith("transferred"):
  1035	            return True
  1036	        # Accept compact transferred headings that start with a section marker,
  1037	        # even when citation tokenization is noisy (e.g., OCR-spaced section ids).
  1038	        if normalized.startswith("\u00a7") and len(normalized) <= 240:
  1039	            return True
  1040	        return self._contains_citation_section_reference(
  1041	            normalized,
  1042	            citation_section,
  1043	        ) or self._starts_with_citation_section_reference(
  1044	            normalized,
  1045	            citation_section,
  1046	        )
