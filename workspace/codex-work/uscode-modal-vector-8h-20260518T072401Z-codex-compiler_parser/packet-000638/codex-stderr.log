  1048	    def _looks_like_editorial_status_heading(
  1049	        self,
  1050	        segment_text: str,
  1051	        *,
  1052	        citation_section: str,
  1053	        previous_segment_text: str = "",
  1054	    ) -> bool:
  1055	        normalized = self.normalize_text(segment_text).lower()
  1056	        if not _USCODE_EDITORIAL_STATUS_HINT_RE.search(normalized):
  1057	            return False
  1058	        if self._contains_citation_section_reference(normalized, citation_section):
  1059	            return True
  1060	        if self._starts_with_citation_section_reference(normalized, citation_section):
  1061	            return True
  1062	        if normalized.startswith("repealed") or normalized.startswith("omitted") or normalized.startswith("reserved"):
  1063	            previous = self.normalize_text(previous_segment_text).lower()
  1064	            if self._contains_citation_section_reference(previous, citation_section):
  1065	                return True
  1066	            if self._starts_with_citation_section_reference(previous, citation_section):
  1067	                return True
  1068	            if len(_TOKEN_RE.findall(normalized)) <= 6:
  1069	                return True
  1070	        if normalized.startswith("\u00a7") and len(normalized) <= 240:
  1071	            return True
  1072	        return False
