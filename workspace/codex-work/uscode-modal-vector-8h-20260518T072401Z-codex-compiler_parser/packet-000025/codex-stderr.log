   109	
   110	class LegalModalParser:
   111	    """Small deterministic parser that compiles legal text into modal IR."""
   112	
   113	    def __init__(self, registry: ModalRegistry = DEFAULT_MODAL_REGISTRY) -> None:
   114	        self.registry = registry
   115	
   116	    def normalize_text(self, text: str) -> str:
   117	        """Normalize whitespace while preserving legal punctuation."""
   118	        return _WHITESPACE_RE.sub(" ", text).strip()
   119	
   120	    def segment(self, text: str) -> List[LegalSegment]:
   121	        """Split normalized legal text into deterministic legal segments."""
   122	        normalized = self.normalize_text(text)
   123	        segments: List[LegalSegment] = []
   124	        for match in _SEGMENT_RE.finditer(normalized):
   125	            segment_text = match.group(0).strip()
   126	            if not segment_text:
   127	                continue
   128	            segments.append(
   129	                LegalSegment(
   130	                    text=segment_text,
   131	                    start_char=match.start(),
   132	                    end_char=match.end(),
   133	                    role=self._classify_segment_role(segment_text),
   134	                )
   135	            )
   136	        return segments
   137	
   138	    def extract_cues(self, text: str) -> List[ModalCueSpan]:
   139	        """Extract modal cue spans from text using registry cue terms."""
   140	        normalized = self.normalize_text(text)
   141	        found: List[ModalCueSpan] = []
   142	        for profile in self.registry.all_profiles():
   143	            for operator in profile.operators:
   144	                for cue in operator.cue_terms:
   145	                    pattern = re.compile(rf"(?<!\w){re.escape(cue)}(?!\w)", re.IGNORECASE)
   146	                    for match in pattern.finditer(normalized):
   147	                        if self._is_calendar_month_may_cue(
   148	                            normalized_text=normalized,
   149	                            cue=cue,
   150	                            start_char=match.start(),
   151	                            end_char=match.end(),
   152	                        ):
   153	                            continue
   154	                        found.append(
   155	                            ModalCueSpan(
   156	                                family=profile.family,
   157	                                profile=profile,
   158	                                operator=operator,
   159	                                cue=cue,
   160	                                start_char=match.start(),
   161	                                end_char=match.end(),
   162	                            )
   163	                        )
   164	        return sorted(found, key=lambda cue: (cue.start_char, cue.end_char, cue.family.value, cue.operator.symbol))
   165	
   166	    def _is_calendar_month_may_cue(
   167	        self,
   168	        *,
   169	        normalized_text: str,
   170	        cue: str,
   171	        start_char: int,
   172	        end_char: int,
   173	    ) -> bool:
   174	        """Treat `May 13, 2002` date literals as temporal context, not deontic permission."""
   175	        if cue.lower() != "may":
   176	            return False
   177	        if start_char > 0 and normalized_text[start_char - 1].isalnum():
   178	            return False
   179	        trailing = normalized_text[end_char:]
   180	        return bool(re.match(r"^\s+\d{1,2}(?:,\s*|\s+)\d{4}\b", trailing))
   181	
   182	    def parse(
   183	        self,
   184	        text: str,
   185	        *,
   186	        document_id: Optional[str] = None,
   187	        source: str = "legal_text",
   188	        citation: Optional[str] = None,
   189	    ) -> ModalIRDocument:
   190	        """Parse legal text into canonical modal IR."""
   191	        normalized = self.normalize_text(text)
   192	        resolved_document_id = document_id or self._document_id(normalized)
   193	        segments = self.segment(normalized)
   194	        cues = self.extract_cues(normalized)
   195	        formulas: List[ModalIRFormula] = []
   196	
   197	        for index, cue in enumerate(cues, start=1):
   198	            segment = self._segment_for_cue(segments, cue)
   199	            predicate = self._predicate_from_segment(segment.text, cue.cue)
   200	            conditions, exceptions = self._conditions_and_exceptions_from_segment(
   201	                segment.text
   202	            )
   203	            formulas.append(
   204	                ModalIRFormula(
   205	                    formula_id=f"{resolved_document_id}:f{index:04d}",
   206	                    operator=ModalIROperator(
   207	                        family=cue.family.value,
   208	                        system=cue.profile.system.value,
   209	                        symbol=cue.operator.symbol,
   210	                        label=cue.operator.aliases[0] if cue.operator.aliases else cue.operator.symbol,
   211	                    ),
   212	                    predicate=ModalIRPredicate(
   213	                        name=predicate,
   214	                        arguments=[],
   215	                        role=segment.role,
   216	                    ),
   217	                    provenance=ModalIRProvenance(
   218	                        source_id=resolved_document_id,
   219	                        start_char=segment.start_char,
   220	                        end_char=segment.end_char,

