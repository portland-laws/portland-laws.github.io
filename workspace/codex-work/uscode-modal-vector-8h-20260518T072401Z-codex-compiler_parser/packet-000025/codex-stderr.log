   218	            for selection in frame_selections
   219	        ]
   220	        metadata = {
   221	            **modal_ir.metadata,
   222	            "ambiguity_count": ambiguity_count,
   223	            "deterministic_compiler": "modal_compiler_v1",
   224	            "deterministic_parser": parser_name,
   225	            "frame_selector": "bm25_v1",
   226	            "llm_call_count": 0,
   227	            "modal_family_counts": encoding.modal_family_counts(),
   228	            "selected_frame": selected_frame,
   229	        }
   230	        return replace(modal_ir, frame_candidates=frame_candidates, metadata=metadata)
