   201	    def _attach_metadata(
   202	        self,
   203	        modal_ir: ModalIRDocument,
   204	        frame_selections: Sequence[FrameSelection],
   205	        *,
   206	        parser_name: str,
   207	        selected_frame: Optional[str],
   208	        ambiguity_count: int,
   209	        encoding: SpaCyLegalEncoding,
   210	    ) -> ModalIRDocument:
   211	        frame_candidates = [
   212	            ModalIRFrame(
   213	                frame_id=selection.frame.frame_id,
   214	                score=selection.score,
   215	                matched_terms=list(selection.matched_terms),
   216	                explanation=selection.explanation,
