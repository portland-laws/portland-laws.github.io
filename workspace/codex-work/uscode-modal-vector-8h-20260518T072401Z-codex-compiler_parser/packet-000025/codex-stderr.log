    99	class ModalCueSpan:
   100	    """A registry cue found in text."""
   101	
   102	    family: ModalLogicFamily
   103	    profile: ModalParseProfile
   104	    operator: ModalOperatorSpec
   105	    cue: str
   106	    start_char: int
   107	    end_char: int
