   198	    def _classify_segment_role(self, text: str) -> str:
   199	        lowered = text.lower()
   200	        if lowered.startswith(("if ", "unless ", "except ", "provided that ", "subject to ")):
   201	            return "condition"
   202	        if " means " in lowered or lowered.startswith("the term "):
   203	            return "definition"
   204	        if any(term in lowered for term in ("penalty", "fine", "sanction", "remedy")):
   205	            return "remedy"
   206	        return "clause"
