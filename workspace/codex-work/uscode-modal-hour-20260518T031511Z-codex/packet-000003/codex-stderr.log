   208	    def _segment_for_cue(self, segments: Iterable[LegalSegment], cue: ModalCueSpan) -> LegalSegment:
   209	        for segment in segments:
   210	            if segment.start_char <= cue.start_char < segment.end_char:
   211	                return segment
   212	        return LegalSegment(text="", start_char=cue.start_char, end_char=cue.end_char)
   213	
   214	    def _predicate_from_segment(self, segment_text: str, cue: str) -> str:
